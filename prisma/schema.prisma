// prisma/schema.prisma
// Works with PostgreSQL (recommended). You can switch provider if needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN // platform super admin
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  AIRPORT_ADMIN
  OPS
  CONTENT_EDITOR
}

enum ArtworkStatus {
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
  EXPIRED
}

enum PublishTargetType {
  PLAYLIST
  DISPLAY_GROUP
  LAYOUT_REGION_PLAYLIST
}

enum ToiletIssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum FlightEventType {
  GATE_CHANGE
  BOARDING
  FINAL_CALL
  DELAY
  CANCELLED
}

enum MediaType {
  IMAGE
  VIDEO
  PDF
}

enum DeviceStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  USER_CREATE
  USER_DISABLE
  USER_ROLE_CHANGE

  ARTWORK_APPROVE
  ARTWORK_REJECT
  ARTWORK_PUBLISH

  TOILET_ISSUE_CREATE
  TOILET_ISSUE_RESOLVE
  TOILET_CLEAN

  FLIGHT_SUBSCRIBE
  FLIGHT_UNSUBSCRIBE
  FLIGHT_SNAPSHOT_UPDATE

  XIBO_SYNC_SUCCESS
  XIBO_SYNC_ERROR

  DEVICE_APPROVE
  DEVICE_REJECT
}
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String? // null for OAuth users
  role         UserRole
  tenantId     String?
  locale       String? // per-user UI language override (falls back to tenant.locale, then "en")

  isActive Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  lastLoginAt DateTime?

  // NextAuth relations
  accounts AuthAccount[]
  sessions Session[]
  votes    Vote[]

  // Your existing relations
  approvedArtworks    Artwork[]            @relation("ApprovedBy")
  flightSubscriptions FlightSubscription[] @relation("UserFlightSubscriptions")
  AuditLog            AuditLog[]
  tenant              Tenant?              @relation(fields: [tenantId], references: [id])
  createdMedia        MediaAsset[]         @relation("MediaCreatedBy")
  createdPlaylists    Playlist[]           @relation("PlaylistCreatedBy")
  approvedDevices     Device[]             @relation("DeviceApprovedBy")

  @@index([role])
  @@index([email])
}

model Tenant {
  id                 String               @id @default(cuid())
  name               String
  type               String // "SCHOOL" or "AIRPORT"
  locale             String               @default("en") // default UI/display language for this tenant's users and public pages
  timezone           String               @default("Asia/Tokyo") // IANA name - resolves "9am" per-tenant, not per-server
  users              User[]
  artworks           Artwork[]
  createdAt          DateTime             @default(now())
  deletedAt          DateTime?
  Vote               Vote[]
  AuditLog           AuditLog[]
  FlightSubscription FlightSubscription[]
  ToiletIssue        ToiletIssue[]
  ToiletCleaningLog  ToiletCleaningLog[]
  XiboDisplayHealth  XiboDisplayHealth[]
  PublishTarget      PublishTarget[]
  MediaAsset         MediaAsset[]
  Playlist           Playlist[]
  Device             Device[]
}



model AuthAccount {
  id                String @id @default(cuid())
  userId            String
  type              String // "credentials" | "oauth"
  provider          String // "credentials" | "google" | "github"
  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model AuditLog {
  id     String      @id @default(cuid())
  action AuditAction

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  target   String? // e.g. "User:12", "Artwork:55", "Toilet:T1-L2-03"
  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?
  tenantId  String?
  tenant    Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([action, createdAt])
  @@index([actorId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Vote {
  id           String   @id @default(cuid())
  userId       String? // null for anonymous/parent votes - only set for a logged-in voter
  artworkId    String
  tenantId     String?
  voterIp      String? // recorded for abuse monitoring only, not used to block votes (shared school/airport wifi)
  voterSession String? // long-lived random id from a cookie - the actual anonymous dedup key
  createdAt    DateTime @default(now())

  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  tenant  Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([userId, artworkId])
  @@unique([artworkId, voterSession])
  @@index([userId])
  @@index([artworkId])
  @@index([tenantId])
}

model FlightSubscription {
  id          String    @id @default(cuid())
  flightKey   String
  airportCode String?
  locale      String    @default("en")
  pushSub     Json?
  phoneE164   String?
  smsVerified Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  expiresAt   DateTime
  tenantId    String?
  userId      String?
  user        User?     @relation("UserFlightSubscriptions", fields: [userId], references: [id], onDelete: SetNull)

  events NotificationEvent[]
  tenant Tenant?             @relation(fields: [tenantId], references: [id])

  @@index([flightKey, isActive])
  @@index([expiresAt])
  @@index([phoneE164])
}

model Artwork {
  id          String        @id @default(cuid())
  title       String
  description String?
  grade       String?
  className   String?
  studentName String?
  imagePath   String // Local storage path or URL of the resized image (~1080p) for Xibo
  votingQrUrl String? // Store QR code URL for voting, generated after artwork approval
  status      ArtworkStatus @default(PENDING) // Approval workflow: PENDING -> APPROVED/REJECTED -> PUBLISHED
  rejectReason String? // Reason recorded when status is set to REJECTED
// New: Metadata for Xibo Optimization
  width        Int?
  height       Int?
  fileSize     Int?          // in bytes
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation("ApprovedBy", fields: [approvedById], references: [id])

  publishedAt    DateTime?
  expiresAt      DateTime?
  xiboMediaId    Int? // Media ID returned from Xibo CMS after upload
  xiboPlaylistId Int?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  tenantId       String?
  votes          Vote[]
  publishTargets PublishTarget[]
  tenant         Tenant?         @relation(fields: [tenantId], references: [id])

  @@index([status, createdAt])
  @@index([xiboMediaId])
}

model PublishTarget {
  id        String  @id @default(cuid())
  artworkId String
  artwork   Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  tenantId   String            // Fixed: Added for multi-tenant safety
  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  targetType PublishTargetType // Type of Xibo target: PLAYLIST, DISPLAY_GROUP, or LAYOUT_REGION
  targetId   String // Xibo ID (playlistId, displayGroupId, etc.) stored as string for flexibility
  duration   Int               @default(10) // Display duration in seconds for each artwork in the loop

  createdAt DateTime @default(now())

  @@index([tenantId, targetId])
  @@index([artworkId])
}

model FlightSnapshot {
  id        Int    @id @default(autoincrement())
  flightKey String @unique

  // normalized fields
  airline  String?
  flightNo String?
  status   String? // Current status: "SCHEDULED" | "BOARDING" | "DELAYED" | "DEPARTED" | "CANCELLED" 
  gate     String?

  scheduledTime DateTime?
  estimatedTime DateTime?
  actualTime    DateTime?

  delayMinutes Int?

  providerName      String
  providerRaw       Json? // Original JSON response from Flight API for debugging and RCA (Root Cause Analysis)
  providerUpdatedAt DateTime?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model NotificationEvent {
  id             String             @id @default(cuid())
  subscriptionId String
  subscription   FlightSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscribedFrom String? // e.g. "ENTRANCE_A_QR", "TOILET_GATE_22_QR"
  flightKey      String
  type           FlightEventType // Type of alert: GATE_CHANGE, DELAY, BOARDING, etc.
  eventKey       String // Deduplication key: e.g., "GATE_CHANGE:22" or "DELAY:35" to prevent double alerts
  message        String?
  payload        Json?

  createdAt DateTime @default(now())

  @@unique([subscriptionId, eventKey])
  @@index([flightKey, createdAt])
}

model ToiletIssue {
  id         Int               @id @default(autoincrement())
  locationId String // Unique location code: e.g., "T1-L2-MALE-03" (Terminal 1, Level 2)
  type       String // Issue category: "NO_TISSUE" | "SMELL" | "LEAK" | "DIRTY"
  note       String?
  status     ToiletIssueStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resolvedAt DateTime?
  tenantId   String?
  tenant     Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([locationId, status])
  @@index([createdAt])
}

model ToiletCleaningLog {
  id         Int      @id @default(autoincrement())
  locationId String
  cleanedAt  DateTime @default(now())
  cleanedBy  String? // Staff name or ID who performed the cleaning task
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([locationId, cleanedAt])
}

model XiboDisplayHealth {
  id             Int       @id @default(autoincrement())
  displayId      String    @unique
  displayName    String?
  displayGroupId String?
  status         String? // Xibo Player status: "ONLINE" | "OFFLINE" | "DOWNLOAD_IN_PROGRESS"
  lastSeenAt     DateTime? // The last time the Xibo Player checked in with the CMS
  lastSyncAt     DateTime?
  deletedAt      DateTime?

  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// The platform's own media library - the first piece of the native CMS that
/// replaces Xibo's, per the phased migration plan (own data model now,
/// publish still goes through Xibo's proven upload/assign API under the hood
/// until a player runtime exists to remove that dependency).
model MediaAsset {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  type            MediaType
  title           String
  storagePath     String // local /uploads/... path or an absolute Blob/S3 URL - see src/lib/storage.ts
  mimeType        String?
  fileSize        Int? // bytes
  durationSeconds Int? // video only
  tags            String[] @default([])

  xiboMediaId Int? // dedup/idempotency once published to Xibo, same pattern as Artwork.xiboMediaId

  createdById String?
  createdBy   User?   @relation("MediaCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  playlistItems PlaylistItem[]

  @@index([tenantId, type])
  @@index([xiboMediaId])
}

model Playlist {
  id   String @id @default(cuid())
  name String

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdById String?
  createdBy   User?   @relation("PlaylistCreatedBy", fields: [createdById], references: [id])

  publishedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  items PlaylistItem[]

  @@index([tenantId])
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  mediaAssetId String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  order           Int
  durationSeconds Int @default(10)

  createdAt DateTime @default(now())

  @@index([playlistId, order])
}

/// First slice of the own player runtime (Phase 2a/2b of the gated Future
/// Direction Vision doc) - registration + heartbeat only. Deliberately not
/// modeling device_groups/device_locations/device_content/sync_history yet;
/// add those when the sync engine (Phase 2c) actually needs them.
model Device {
  id        String       @id @default(cuid())
  deviceUid String       @unique // client-generated UUID, persisted locally by the player - survives re-registration
  tenantId  String? // unknown until approved - a pending device belongs to no tenant yet
  tenant    Tenant?      @relation(fields: [tenantId], references: [id])
  name      String?
  status    DeviceStatus @default(PENDING)

  lastHeartbeatAt DateTime?
  lastIpAddress   String?
  cpuPct          Float?
  ramPct          Float?
  diskPct         Float?
  playerVersion   String?

  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation("DeviceApprovedBy", fields: [approvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  registrations DeviceRegistration[]
  tokens        DeviceToken[]

  @@index([tenantId, status])
}

/// One row per registration *attempt*, kept even after claiming, so "who
/// registered device X and when" is always answerable.
model DeviceRegistration {
  id               String    @id @default(cuid())
  deviceId         String
  device           Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  registrationCode String    @unique // short, human-typeable, single-use
  ipAddress        String?
  expiresAt        DateTime // ~15 minutes from creation
  claimedAt        DateTime? // set once the player successfully exchanges it for tokens

  createdAt DateTime @default(now())

  @@index([registrationCode])
  @@index([deviceId])
}

/// Only refresh tokens are persisted (so they can be revoked/rotated).
/// Access tokens are short-lived, stateless JWTs verified by signature -
/// never written here.
model DeviceToken {
  id            String    @id @default(cuid())
  deviceId      String
  device        Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique // sha256 of the raw refresh token - never store it raw
  issuedAt      DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  rotatedFromId String? // chains to the token this one replaced - a replayed old token is detectable

  @@index([deviceId])
}
