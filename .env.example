# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# --- NextAuth ---
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# --- Xibo CMS v4 ---
XIBO_BASE_URL="https://your-staging-cms.example.com"
XIBO_CLIENT_ID="xibo-application-client-id"
XIBO_CLIENT_SECRET="xibo-application-client-secret"
XIBO_PLAYLIST_ID="1"

# TLS: leave false. Set true ONLY for a self-signed LAN/staging CMS you control.
XIBO_ALLOW_INSECURE_TLS="false"

# --- Cron auth (protects /api/cron/*) ---
CRON_SECRET="generate-with: openssl rand -base64 32"

# --- File storage (Vercel Blob) ---
# Required for artwork uploads to work - Vercel's serverless functions have a
# read-only filesystem, so uploads go to Blob storage instead of local disk.
# Get this from your Vercel dashboard: Project -> Storage -> Create Database
# -> Blob -> .env.local tab (it auto-populates this var when connected).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
